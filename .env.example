# Copy this file to .env and fill in real values. Never commit .env itself.

# Supported values for *_PROVIDER: anthropic | openai | gemini
# Matching key required: ANTHROPIC_API_KEY | OPENAI_API_KEY | GEMINI_API_KEY

# --- Judge model (evaluates outputs) ---
# Using Gemini as judge and OpenAI as generator is a genuine cross-model-family
# pairing for self-enhancement bias mitigation (unlike judging a model with
# a same-provider sibling model, e.g. gpt-4o judging gpt-4o-mini).
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

JUDGE_TEMPERATURE=0.0
JUDGE_MAX_TOKENS=1024
# Optional: for cost estimation in reports (USD per 1M tokens) — check
# current pricing before relying on these, they will go stale.
JUDGE_INPUT_COST_PER_MILLION=1.25
JUDGE_OUTPUT_COST_PER_MILLION=5.00

# --- Generator model (produced the outputs being judged) ---
GENERATOR_PROVIDER=openai
GENERATOR_MODEL=gpt-4o-mini
OPENAI_API_KEY=

GENERATOR_TEMPERATURE=0.7
GENERATOR_MAX_TOKENS=1024
GENERATOR_INPUT_COST_PER_MILLION=0.15
GENERATOR_OUTPUT_COST_PER_MILLION=0.60

# ANTHROPIC_API_KEY= (only needed if you set either provider above to anthropic)

# --- Pipeline behavior ---
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.5
RUN_BOTH_ORDERS=true
REQUEST_TIMEOUT_SECONDS=60
